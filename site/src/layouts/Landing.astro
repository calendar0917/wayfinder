---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Wayfinder — 自托管 AI 仪表盘' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="一个带 AI 助手的自托管导航仪表盘。用自然语言管理书签、小组件和集成服务。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="nav">
      <a class="nav-brand" href="/">Wayfinder</a>
      <div class="nav-links">
        <a href="#features">功能</a>
        <a href="#gallery">预览</a>
        <a href="#quickstart">开始</a>
        <a href="https://github.com/calendar0917/wayfinder">GitHub</a>
      </div>
    </nav>

    <slot />

    <script is:inline>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
