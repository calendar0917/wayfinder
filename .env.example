# Homepage Dashboard Environment Variables
# Copy this file to .env and fill in the values

# Required: Random secret for signing auth tokens (at least 32 characters)
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: OpenAI-compatible API key (overrides settings.yaml)
HOMEPAGE_API_KEY=

# Optional: bcrypt password hash (overrides settings.yaml, set via UI or AI)
HOMEPAGE_PASSWORD_HASH=
