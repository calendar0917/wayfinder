# Wayfinder Dashboard Environment Variables
# Copy this file to .env.local and fill in the values.
#
# All settings (apiKey, apiBase, aiModel, etc.) are managed in the dashboard UI
# and saved to data/settings.yaml. Env vars here are only used for AUTH_SECRET
# and WAYFINDER_PASSWORD_HASH — the rest are configured via the Settings page.

# Required: Cookie signing secret (signs login cookies, NOT your dashboard password)
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: Data directory path (default: ./data)
# Set to a path OUTSIDE the project directory during development to prevent
# Next.js dev server HMR crashes when config files are written.
# Production (Docker) doesn't need this — the docker-compose mount handles it.
# DATA_DIR=/tmp/wayfinder-data

# Optional: OpenAI-compatible API key (initial default, override in dashboard Settings)
WAYFINDER_API_KEY=

# Optional: API base URL (initial default, override in dashboard Settings)
WAYFINDER_API_BASE=

# Optional: AI model name (initial default, override in dashboard Settings)
WAYFINDER_AI_MODEL=

# Optional: Dashboard login password as bcrypt hash (leave empty to use default "admin")
WAYFINDER_PASSWORD_HASH=

# Optional: Integration API keys (referenced in bookmark integration headers as ${VAR_NAME})
# JELLYFIN_API_KEY=
# PIHOLE_API_KEY=
