# Homepage Dashboard Environment Variables
# Copy this file to .env.local and fill in the values
#
# Secrets should ONLY be set via environment variables, never in settings.yaml.
# In YAML, use ${VAR_NAME} syntax to reference env vars (e.g. apiKey: ${HOMEPAGE_API_KEY}).

# Required: Random secret for signing auth tokens (at least 32 characters)
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Optional: Data directory path (default: ./data)
# Set to a path OUTSIDE the project directory during development to prevent
# Next.js dev server HMR crashes when config files are written.
# Production (Docker) doesn't need this — the docker-compose mount handles it.
# DATA_DIR=/tmp/homepage-data

# Optional: OpenAI-compatible API key (overrides settings.yaml)
HOMEPAGE_API_KEY=

# Optional: API base URL (overrides settings.yaml)
HOMEPAGE_API_BASE=

# Optional: AI model name (overrides settings.yaml)
HOMEPAGE_AI_MODEL=

# Optional: bcrypt password hash (overrides settings.yaml, set via UI or AI)
HOMEPAGE_PASSWORD_HASH=
